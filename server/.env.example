# Server
PORT=8101
HOST=127.0.0.1
NODE_ENV=development
# Web origin allowed by CORS (the learner web app)
WEB_ORIGIN=https://english.daichenlab.com

# Database — reuse the shared BWH Postgres with THIS app's own database + role
DATABASE_URL=postgres://scenario_english:CHANGE_ME@127.0.0.1:5432/scenario_english

# Auth (JWT)
JWT_SECRET=CHANGE_ME_long_random
JWT_REFRESH_SECRET=CHANGE_ME_long_random

# AI provider — official API, OpenAI-compatible (NO 9relay). OpenAI default.
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TEXT_MODEL=gpt-5.4-mini
# ASR — official OpenAI transcription (whisper-1, verbose_json) by default
ASR_MODEL=whisper-1
# Optional self-hosted faster-whisper endpoint (future); leave blank to use OpenAI
WHISPER_URL=

# Gemini provider (OpenAI-compatible). If GEMINI_API_KEY is unset, tasks that
# default to gemini (scoring, item_gen) degrade to OpenAI automatically.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Per-task model overrides (optional; DB/admin overrides take precedence).
# Defaults (eval-based): feedback/dialogue=openai gpt-5.4-mini, scoring=gemini
# gemini-3.1-pro-preview, item_gen=gemini gemini-3-flash-preview, asr=openai whisper-1.
# AI_SCORING_PROVIDER=gemini
# AI_SCORING_MODEL=gemini-3.1-pro-preview

# Social sign-in (Sign in with Google / Apple). Public client ids only — these
# are the allowed JWT audiences when verifying provider ID tokens. When a
# provider's client id is unset, its /v1/auth/oauth/* endpoint returns 503
# (provider_not_configured) instead of crashing the server.
# Google Cloud OAuth Client ID (Web) — authorized origin https://english.daichenlab.com
GOOGLE_CLIENT_ID=
# Google OAuth Client ID (iOS) — for the native app sign-in (added later)
GOOGLE_IOS_CLIENT_ID=
# Apple Services ID (the web flow client_id)
APPLE_CLIENT_ID=
# Apple iOS bundle id (native flow audience); defaults to com.cdcupt.DailyEnglish
APPLE_IOS_CLIENT_ID=com.cdcupt.DailyEnglish
