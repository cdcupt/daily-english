# API mode: "mock" returns local sample data; anything else uses the live API.
NEXT_PUBLIC_API_MODE=mock
# Live API base (used when NEXT_PUBLIC_API_MODE is not "mock").
NEXT_PUBLIC_API_URL=https://api.english.daichenlab.com/v1
# Mock-mode role for the operator /admin surface. Defaults to "operator" so
# /admin renders offline; set to "user" to preview the 404 gate. Inlined at
# build time (NEXT_PUBLIC_*), so rebuild after changing. Ignored in live mode,
# where the role is read from the real JWT.
NEXT_PUBLIC_MOCK_ROLE=operator
